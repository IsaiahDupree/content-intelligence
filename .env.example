# Content Intelligence Service Configuration

# Service Settings
PORT=6006

# External Services
MEDIAPOSTER_URL=http://localhost:5555
MEDIA_PIPELINE_URL=http://localhost:6004
REDIS_URL=redis://localhost:6379

# AI Provider Keys (at least one required for real AI)
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Default AI provider (groq, openai, anthropic)
DEFAULT_AI_PROVIDER=groq

# Rate limiting
MAX_REQUESTS_PER_MINUTE=60
