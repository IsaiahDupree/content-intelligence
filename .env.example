# Content Intelligence Service Configuration

# Service Settings
PORT=6006

# External Services
MEDIAPOSTER_URL=http://localhost:5555
MEDIA_PIPELINE_URL=http://localhost:6004
REDIS_URL=redis://localhost:6379

# AI Provider Keys (at least one required for real AI)
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Default AI provider (groq, openai, anthropic)
DEFAULT_AI_PROVIDER=groq

# Rate limiting
MAX_REQUESTS_PER_MINUTE=60

# === Content Intelligence System (Node.js CLI) ===

# Supabase (shared project)
SUPABASE_URL=https://ivhfuhxorppptyuofbgq.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
# Alternate name used by the shared ACTP environment.
SUPABASE_SERVICE_ROLE_KEY=

# Blotato API
BLOTATO_API_KEY=your_blotato_api_key_here
BLOTATO_API_URL=https://backend.blotato.com/v2

# MPLite
MPLITE_URL=https://mediaposter-lite-isaiahduprees-projects.vercel.app

# Local video directories (comma-separated)
LOCAL_VIDEO_DIRS=/path/to/videos,/path/to/more/videos

# Social Market Tape V1
MARKET_TAPE_DB_PATH=data/market-tape.sqlite3
MARKET_TAPE_OBJECT_DIR=data/market-tape-objects
MARKET_TAPE_LOCAL_RESEARCH_DIR=~/Library/Application Support/SafariAutomation/market-research-data
MARKET_TAPE_LOCAL_RESEARCH_TRIGGER_ENABLED=true
MARKET_TAPE_LOCAL_RESEARCH_REFRESH_SECONDS=86400
MARKET_TAPE_SOURCE_FAILURE_BACKOFF_SECONDS=3600
MARKET_TAPE_SOURCE_AUTH_BACKOFF_SECONDS=86400
MARKET_TAPE_SOURCE_QUOTA_BACKOFF_SECONDS=21600
MARKET_TAPE_SOURCE_APPROVAL_BACKOFF_SECONDS=900
MARKET_TAPE_SOURCE_MAX_BACKOFF_SECONDS=86400
MARKET_RESEARCH_URL=http://127.0.0.1:3106
MARKET_TAPE_DAILY_UNIQUE_TARGET=5000
MARKET_TAPE_PLATFORMS=youtube,tiktok,instagram,x,facebook,threads
MARKET_TAPE_TOPICS=live sports,music releases,celebrity news,movie trailers,television,video games,breaking news,politics,weather,food,consumer products,finance,technology,science,health,travel,pets,comedy,relationships,true crime,fashion,cars
MARKET_TAPE_ADAPTIVE_TOPICS_ENABLED=true
MARKET_TAPE_ADAPTIVE_TOPIC_LIMIT=30
MARKET_TAPE_ADAPTIVE_TOPIC_WINDOW_HOURS=168
MARKET_TAPE_ADAPTIVE_TOPIC_MIN_VIDEOS=2
MARKET_TAPE_ADAPTIVE_TOPIC_EXPLORATION_FRACTION=0.2
MARKET_TAPE_OVERFLOW_PLATFORMS=youtube
MARKET_TAPE_MAX_DISCOVERY_ITEMS_PER_SOURCE=5000
MARKET_TAPE_REGIONS=US
MARKET_TAPE_YOUTUBE_CHART_CATEGORIES=all,1,2,10,15,17,19,20,22,23,24,25,26,27,28
MARKET_TAPE_CYCLE_SECONDS=900
MARKET_TAPE_DISCOVERY_INTERVAL_SECONDS=14400
MARKET_TAPE_ALLOW_METERED_READS=false
MARKET_TAPE_MAX_DAILY_PROVIDER_COST_USD=5.00
MARKET_TAPE_YOUTUBE_SEARCH_DAILY_LIMIT=80
# Direct RapidAPI Upwork buyer-demand lane. Every scan still requires the
# per-call execute_metered_reads gate; this timeout does not affect other sources.
MARKET_TAPE_UPWORK_DEFAULT_QUERIES=AI automation,AI agent,workflow automation,OpenAI
MARKET_TAPE_UPWORK_MAX_QUERIES_PER_SCAN=5
MARKET_TAPE_UPWORK_DAILY_REQUEST_LIMIT=10
MARKET_TAPE_UPWORK_REQUEST_TIMEOUT_SECONDS=60
MARKET_TAPE_UPWORK_PREDICTION_MIN_SNAPSHOTS=3
UPWORK_SCRAPER_RAPIDAPI_KEY=
UPWORK_SCRAPER_HOST=upwork-jobs-scraper-api.p.rapidapi.com
UPWORK_SCRAPER_BASE_URL=https://upwork-jobs-scraper-api.p.rapidapi.com
# Provider-free breakout crossing detector. Detection queues evidence and
# semantic review; it never auto-approves, renders, publishes, or calls AI.
MARKET_TAPE_RAPID_TREND_TRIGGER_ENABLED=true
MARKET_TAPE_RAPID_TREND_MAX_OBSERVATION_AGE_SECONDS=3600
MARKET_TAPE_RAPID_TREND_MAX_CROSSING_WINDOW_SECONDS=7200
MARKET_TAPE_RAPID_TREND_GENERATION_TTL_SECONDS=21600
MARKET_TAPE_RAPID_TREND_MIN_VIDEOS=3
MARKET_TAPE_RAPID_TREND_MIN_MEASURED_VIDEOS=3
MARKET_TAPE_RAPID_TREND_MIN_ACTIVITY_COVERAGE=0.5
MARKET_TAPE_RAPID_TREND_MIN_VIEWS_NEW_1H=1000
MARKET_TAPE_RAPID_TREND_MAX_SATURATION=0.75
MARKET_TAPE_RAPID_TREND_MAX_PER_CYCLE=3
MARKET_TAPE_RAPID_TREND_MAX_PER_DAY=10
MARKET_TAPE_RAPID_TREND_DEMAND_VERIFIED_TRANSCRIPTS=5
MARKET_TAPE_RAPID_TREND_DEMAND_DISTINCT_CREATORS=3
MARKET_TAPE_RAPID_TREND_DEMAND_OBSERVED_VIEWS=100000
MARKET_TAPE_RAPID_TREND_AUDIENCE=software founders
MARKET_TAPE_RAPID_TREND_OBJECTIVE=qualified attention
# Promoted-model cohorts are admitted only when these future measurement
# requests can be reserved atomically. Six units preserves three conservative
# two-request YouTube refresh batches for validation.
MARKET_TAPE_PREDICTION_VALIDATION_COHORT_LIMIT=100
MARKET_TAPE_PREDICTION_VALIDATION_INTERVAL_SECONDS=3600
MARKET_TAPE_PREDICTION_MEASUREMENT_CLAIM_TTL_SECONDS=900
MARKET_TAPE_PREDICTION_VALIDATION_REQUEST_FLOOR=6
MARKET_TAPE_REQUEST_LIMIT_YOUTUBE=180
MARKET_TAPE_REQUEST_LIMIT_TIKTOK=120
MARKET_TAPE_REQUEST_LIMIT_INSTAGRAM=100
MARKET_TAPE_REQUEST_LIMIT_X=60
MARKET_TAPE_REQUEST_LIMIT_FACEBOOK=60
MARKET_TAPE_REQUEST_LIMIT_THREADS=60
# Optional known provider-plan rates; zero means unpriced, with request caps still enforced.
MARKET_TAPE_COST_PER_REQUEST_YOUTUBE=0
MARKET_TAPE_COST_PER_REQUEST_TIKTOK=0
MARKET_TAPE_COST_PER_REQUEST_INSTAGRAM=0
MARKET_TAPE_COST_PER_REQUEST_X=0
MARKET_TAPE_COST_PER_REQUEST_FACEBOOK=0
MARKET_TAPE_COST_PER_REQUEST_THREADS=0
MARKET_TAPE_CONTROL_TOKEN=
MARKET_TAPE_API_URL=http://127.0.0.1:6006
MARKET_TAPE_DEMAND_TIMEOUT_SECONDS=5
MARKET_TAPE_SUPABASE_SYNC_ENABLED=true
MARKET_TAPE_SUPABASE_SYNC_BATCH_SIZE=1000

# Content Quality (loopback :6010). The runtime env builder generates and
# preserves the control token; never commit the generated value.
CONTENT_QUALITY_CONTROL_TOKEN=
NARRATIVE_COHERENCE_LLM=openai
NARRATIVE_JUDGE_MODEL=gpt-5-nano
RELATABILITY_JUDGE=openai
RELATABILITY_JUDGE_MODEL=gpt-5-nano
CQ_HEALTH_CACHE_SECONDS=300
# Leave empty to use the local low-latency manifest/audit store under
# ~/Library/Application Support/ContentQuality. Acquisition-time source audio
# and Whisper artifact paths may still reference the Passport volume.
TRANSCRIPT_BANK_ROOT=

# Discovery/read providers (all optional; unavailable lanes stay visible)
YOUTUBE_API_KEY=
RAPIDAPI_KEY=
X_BEARER_TOKEN=
TIKTOK_RESEARCH_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
THREADS_ACCESS_TOKEN=
