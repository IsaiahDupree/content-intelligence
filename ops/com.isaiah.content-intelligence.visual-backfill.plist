<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.isaiah.content-intelligence.visual-backfill</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/isaiahdupree/Library/Application Support/ContentQuality/runtime/scripts/extract_visual_cohort.py</string>
    <string>--limit</string>
    <string>10</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/isaiahdupree/Library/Application Support/ContentQuality/runtime</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
