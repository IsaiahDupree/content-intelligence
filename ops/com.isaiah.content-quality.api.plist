<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.isaiah.content-quality.api</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/isaiahdupree/Library/Application Support/ContentQuality/runtime/run_content_quality_api.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <!-- launchd's default soft maxfiles is 256. Under the Ops Console's probe pattern this
       server reached ~400 open market-tape descriptors and started failing every request
       with OSError 24 (too many open files), taking the narrative-coherence gate down.
       Headroom, not a fix: see the health cache in services/content_quality/api.py. -->
  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>4096</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/content-quality-api.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/content-quality-api.error.log</string>
</dict>
</plist>
