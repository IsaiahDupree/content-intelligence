# Production environment variables for Content Intelligence Service
# Set these in Vercel Dashboard or use .env file in production

# Service Configuration
PORT=6006
NODE_ENV=production
LOG_LEVEL=info

# Supabase Configuration
SUPABASE_URL=https://ivhfuhxorppptyuofbgq.supabase.co
SUPABASE_SERVICE_KEY=${SUPABASE_SERVICE_KEY}

# API Keys (optional, for enhanced features)
OPENAI_API_KEY=${OPENAI_API_KEY}
GROQ_API_KEY=${GROQ_API_KEY}
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}

# Monitoring & Health Check
HEALTH_CHECK_INTERVAL=300000
HEALTH_CHECK_TIMEOUT=10000

# Feature Flags
ENABLE_CLASSIFICATION=true
ENABLE_SCORING=true
ENABLE_REPURPOSING=true
ENABLE_CHECKBACK=true

# Database
DB_TIMEOUT=5000
DB_POOL_SIZE=10
